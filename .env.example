CANVAS_BASE_URL=https://mcpsmd.instructure.com
# Leave empty to use clearly labeled demo data.
CANVAS_ACCESS_TOKEN=
# A separate app passphrase (at least 8 characters). Never your Canvas password.
# Required whenever a Canvas token is configured, including local development.
# Also required to connect StudentVUE from the Gradebook page.
# StudentVUE credentials are entered in the app, not in this file.
# Optional: 32+ random characters that sign app sessions and encrypt saved
# StudentVUE sign-ins. Changing it (or APP_PASSWORD) signs every device out.
APP_SECRET=
APP_PASSWORD=
# Set to your exact Render URL on deployment, without a trailing slash.
APP_ORIGIN=http://127.0.0.1:5173
PORT=3001

# Your private StudentVUE relay. Never use VITE_ prefixes for these settings.
STUDENTVUE_RELAY_URL=https://studentvue-relay.ezsmile331.workers.dev/fulfillAxios
# Must match the Cloudflare Worker's RELAY_TOKEN secret.
STUDENTVUE_RELAY_TOKEN=
